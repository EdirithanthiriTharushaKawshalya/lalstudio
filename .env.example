NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Legacy anon keys also work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Setup only: session pooler connection URI, including the database password.
# Used to apply migrations; not needed by the running website.
SUPABASE_DB_URL=
# Random 32+ byte secret for gallery session signatures and hashed rate-limit identifiers.
APP_SECRET=
# Secret for scheduled /api/retention endpoint. Owner must choose retention days in settings.
CRON_SECRET=
